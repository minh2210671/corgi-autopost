# ============================================================
# Khai báo các biến này trong Vercel → Project → Settings → Environment Variables
# (chạy thử trên máy thì copy thành .env.local)
# ============================================================

# Mật khẩu đăng nhập vào web app
APP_PASSWORD=doi-mat-khau-nay

# Chuỗi bí mật bất kỳ, bảo vệ đường dẫn /api/cron
CRON_SECRET=mot-chuoi-ngau-nhien-dai

# ----- OpenAI (ChatGPT) -----
OPENAI_API_KEY=sk-...
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=high

# ----- Google Gemini (Veo 3) -----
GEMINI_API_KEY=AIza...
# veo-3.1-fast-generate-preview | veo-3.1-generate-preview | veo-3.0-generate-001 | veo-3.0-fast-generate-001
VEO_MODEL=veo-3.1-fast-generate-preview
VEO_ASPECT_RATIO=9:16
VEO_RESOLUTION=720p
VEO_DURATION_SECONDS=8
# Số video Veo render cùng lúc
MAX_PARALLEL_RENDERS=3

# ----- Facebook -----
FB_GRAPH_VERSION=v23.0
# Không bắt buộc nhưng nên có: đổi token sang dài hạn để Page token không hết hạn
FB_APP_ID=
FB_APP_SECRET=

# ----- Tự động có sẵn khi kết nối Storage trên Vercel (không cần tự điền) -----
# KV_REST_API_URL / KV_REST_API_TOKEN (hoặc UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)
# BLOB_READ_WRITE_TOKEN
