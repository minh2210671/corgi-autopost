# ===== OpenAI (ChatGPT) =====
OPENAI_API_KEY=sk-...
# Model viết ý tưởng + caption
OPENAI_TEXT_MODEL=gpt-5-mini
# Model tạo ảnh (gpt-image-1, gpt-image-1.5, ...)
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=high

# ===== Google Gemini API (Veo 3) =====
GEMINI_API_KEY=AIza...
# veo-3.0-generate-001 | veo-3.0-fast-generate-001 | veo-3.1-generate-preview | veo-3.1-fast-generate-preview
VEO_MODEL=veo-3.1-fast-generate-preview
VEO_ASPECT_RATIO=9:16
VEO_RESOLUTION=720p
VEO_DURATION_SECONDS=8

# ===== Facebook =====
FB_GRAPH_VERSION=v23.0
# Chỉ cần khi chạy "pages:sync" để tự lấy Page token từ User token dài hạn
FB_USER_ACCESS_TOKEN=

# Ngôn ngữ caption (vi / en)
CAPTION_LANGUAGE=vi
# Chủ đề / phong cách kênh (gợi ý cho AI)
CHANNEL_STYLE=Video ngắn corgi dễ thương, hài hước, đời thường, ánh sáng đẹp, cảm xúc ấm áp
